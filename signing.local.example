# Личная подпись. Скопируй в signing.local (он в .gitignore) и впиши свой Team ID.
# Не конкретный сертификат, а Team + автоподпись: Xcode сам выбирает актуальный сертификат
# и заводит профиль, поэтому истечение или замена сертификата ничего не ломают.
#
# Team ID — поле OU сертификата Apple Development, а не значение в скобках в его имени.
#
# После создания или правки signing.local — make clean: на инкрементальной сборке Xcode
# не перекладывает уже встроенный в бандл CLI, и тот остаётся со старой подписью.
CODE_SIGN_IDENTITY = Apple Development
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM = <OU сертификата>
